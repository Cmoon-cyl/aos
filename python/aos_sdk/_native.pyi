@final
class Context:
    def __init__(
        self,
        *,
        domain_id: int | None = None,
        config: _Path | None = None,
        config_files: Sequence[_Path] = (),
        launch_config: Mapping[str, Any] | None = None,
        cli_overrides: Mapping[str, Any] | None = None,
        security_profile: _Path | None = None,
        _environment: Mapping[str, str] | None = None,
    ) -> None: ...
    @property
    def effective_config(self) -> dict[str, Any]: ...
    def ok(self) -> bool: ...
    def telemetry_snapshot(self) -> dict[str, Any]: ...
    def enable_log_capture(self, capacity: int = 256) -> None: ...
    def disable_log_capture(self) -> None: ...
    def drain_log_records(self) -> list[dict[str, Any]]: ...
    def flush_logs_to_stderr(self) -> int: ...
    def shutdown(self) -> None: ...
    def create_publisher(self, topic: str) -> Publisher: ...
    def create_subscription(self, topic: str) -> Subscription: ...
    def graph(self, timeout: float = 0.2) -> list[dict[str, Any]]: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

