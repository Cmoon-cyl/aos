@final
class _Node:
    def __init__(
        self,
        context: Context,
        name: str,
        namespace: str = "/",
        *,
        display_name: str | None = None,
        summary: str = "",
        tags: Sequence[str] = (),
        config_files: Sequence[_Path] = (),
        remaps: Sequence[Mapping[str, Any]] | None = None,
        use_sim_time: bool | None = None,
        launch_config: Mapping[str, Any] | None = None,
        cli_overrides: Mapping[str, Any] | None = None,
        parameter_overrides: Mapping[str, Any] | None = None,
        lifecycle: bool = False,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def namespace(self) -> str: ...
    @property
    def fully_qualified_name(self) -> str: ...
    def resolve_name(self, name: str, *, kind: _NameKind = "any") -> str: ...
    def resolve_name_details(
        self, name: str, *, kind: _NameKind = "any",
    ) -> dict[str, Any]: ...
    def effective_config(self) -> dict[str, Any]: ...
    def node_card(self) -> dict[str, Any]: ...
    def destroy_node(self) -> None: ...
    def clock(self) -> _Clock: ...
    def lifecycle(self) -> _Lifecycle | None: ...
    def enable_lifecycle_services(self) -> _LifecycleServer: ...
    def parameters(self) -> _ParameterStore: ...
    def enable_parameter_services(self) -> _ParameterServer: ...
    def enable_parameter_events(self) -> None: ...
    def set_use_sim_time(self, enabled: bool) -> None: ...
    def create_timer(
        self, period: float, *, clock: _Clock | None = None,
        autostart: bool = True,
    ) -> _Timer: ...
    def create_rate(
        self, frequency: float, *, clock: _Clock | None = None,
    ) -> _Rate: ...
    def create_publisher(
        self, interface: Interface, name: str, qos: _QoSInput, *,
        summary: str = "", side_effects: str | None = None,
        contract_version: str | None = None,
    ) -> Publisher: ...
    def create_subscription(
        self, interface: Interface, name: str, qos: _QoSInput, *,
        summary: str = "", side_effects: str | None = None,
        contract_version: str | None = None,
    ) -> Subscription: ...
    def create_client(
        self, interface: Interface, name: str, *, qos: _QoSInput = None,
        summary: str = "", side_effects: str | None = None,
        contract_version: str | None = None,
    ) -> _Client: ...
    def create_service(
        self, interface: Interface, name: str, *, qos: _QoSInput = None,
        summary: str = "", side_effects: str | None = None,
        contract_version: str | None = None,
    ) -> _Service: ...

