from os import PathLike
from types import TracebackType
from typing import Any, Callable, Literal, Mapping, Self, Sequence, TypeAlias, final

__version__: str

_Path: TypeAlias = str | PathLike[str]
_QoSInput: TypeAlias = int | str | Mapping[str, Any] | None
_ClockType: TypeAlias = Literal["steady", "system", "ros"]
_NameKind: TypeAlias = Literal["any", "topic", "service", "action"]

class AOSError(Exception): ...
class InvalidArgumentError(AOSError): ...
class ResourceLimitError(InvalidArgumentError): ...
class NotFoundError(AOSError): ...
class CommunicationError(AOSError): ...
class QueueOverflowError(CommunicationError): ...
class NoResponseError(CommunicationError): ...
class WaitTimeoutError(AOSError): ...
class InvalidStateError(AOSError): ...
class InactiveError(InvalidStateError): ...
class ServiceError(AOSError): ...
class ParameterError(AOSError):
    code: str
    reason: str
class BagError(AOSError):
    kind: str
    file_offset: int | None
    report: dict | None

def _inspect_bag(directory: _Path, options_value: Mapping[str, Any] | None = None) -> dict[str, Any]: ...
def _recover_bag(
    source: _Path, destination: _Path, options_value: Mapping[str, Any] | None = None,
) -> dict[str, Any]: ...

