{
  "name": "aos_memory/srv/List",
  "kind": "srv",
  "request": {
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_./:-]*$",
        "default": "",
        "description": "Literal key prefix, not a wildcard or SQL pattern."
      },
      "after_key": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_./:-]*$",
        "default": "",
        "description": "Exclusive key cursor from the previous page."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      }
    },
    "required": [],
    "additionalProperties": false,
    "description": "One consistent page of note metadata, without note text. Separate pages need not share a snapshot.",
    "examples": [
      {
        "prefix": "synthetic/",
        "after_key": "",
        "limit": 50
      }
    ]
  },
  "response": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "message": {
        "type": "string",
        "maxLength": 256
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "SHA-256 of the exact UTF-8 text or JSONL file bytes, as specified by this endpoint."
                    },
                    "text_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "commit_seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "updated_unix_ns": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "key",
                    "revision",
                    "sha256",
                    "text_bytes",
                    "commit_seq",
                    "updated_unix_ns"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              },
              "has_more": {
                "type": "boolean"
              },
              "next_after": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
              },
              "snapshot_seq": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "items",
              "has_more",
              "next_after",
              "snapshot_seq"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "Successful business value, or null for a named business error. Transport errors and timeouts are separate."
      }
    },
    "required": [
      "ok",
      "code",
      "message",
      "data"
    ],
    "additionalProperties": false
  }
}
