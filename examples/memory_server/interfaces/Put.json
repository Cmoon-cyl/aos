{
  "name": "aos_memory/srv/Put",
  "kind": "srv",
  "request": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$",
        "description": "Durable idempotency key. Same normalized arguments replay the original result; different arguments are REQUEST_ID_CONFLICT. Never auto-retry with a new ID."
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$",
        "description": "Logical note key, never a filesystem path."
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536,
        "description": "Note text; max_record_bytes additionally limits actual UTF-8 bytes."
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "default": 0,
        "description": "0 creates only. Updating a note requires its current revision and a new request_id."
      }
    },
    "required": [
      "request_id",
      "key",
      "text"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "request_id": "example-create-1",
        "key": "synthetic/note-1",
        "text": "Remember the synthetic meeting at 10:00.",
        "expected_revision": 0
      }
    ]
  },
  "response": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "message": {
        "type": "string",
        "maxLength": 256
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "commit_seq": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the exact UTF-8 text or JSONL file bytes, as specified by this endpoint."
              },
              "text_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "created": {
                "type": "boolean"
              }
            },
            "required": [
              "request_id",
              "key",
              "revision",
              "commit_seq",
              "sha256",
              "text_bytes",
              "created"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "Successful business value, or null for a named business error. Transport errors and timeouts are separate."
      }
    },
    "required": [
      "ok",
      "code",
      "message",
      "data"
    ],
    "additionalProperties": false
  }
}
