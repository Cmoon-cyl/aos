+        let lane = Arc::new(());
+        let mut delivered = vec![];
+        let mut panics = 0;
+        for iteration in 1..=2 {
+            let batch = outbox.begin_batch();
+            let _ = outbox.enqueue(&lane, iteration);
+            if batch
+                .drain_background(
+                    |_, item| {
