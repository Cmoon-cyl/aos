+#[cfg(test)]
+mod aos_declaration_scope_tests {
+    use super::*;
+    use zenoh_protocol::{
+        core::{Region, WhatAmI},
+        network::{NetworkMessage, Push},
+        zenoh::Put,
+    };
+
+    use crate::net::{primitives::DummyPrimitives, routing::gateway::GatewayBuilder};
+
+    #[test]
+    fn push_ingress_does_not_begin_a_declaration_batch() {
+        let mut config = zenoh_config::Config::default().expanded();
+        config.set_mode(Some(WhatAmI::Client)).unwrap();
+        let gateway = GatewayBuilder::new(&config)
+            .subregions(vec![Region::Local])
+            .build()
+            .unwrap();
+        let face = gateway.new_session(Arc::new(DummyPrimitives));
+        let demux = DeMux::new(
+            (*face).clone(),
+            None,
+            Arc::new(ArcSwapOption::empty()),
+            ZenohIdProto::default(),
+        );
+        let before = gateway.tables.declarations.batch_starts();
+        for _ in 0..128 {
+            let mut message: NetworkMessage = Push {
+                wire_expr: "diagnostic/push/no-declare-scope".into(),
+                ..Put::default().into()
+            }
+            .into();
+            demux.handle_message(message.as_mut()).unwrap();
+        }
+        assert_eq!(
+            gateway.tables.declarations.batch_starts() - before,
+            0,
+            "data-plane ingress unexpectedly created a declaration scope"
+        );
+    }
+}
