+        assert_eq!(outbox.counts(), (1, 0, 1));
+        batch.drain(|_, _| panic!("closed queue is empty"), |_, _| {});
+        dropped_rx.recv_timeout(LIMIT).unwrap();
+        release_tx.send(()).unwrap();
+        worker.join().unwrap();
+        assert_eq!(outbox.counts(), (0, 0, 1));
